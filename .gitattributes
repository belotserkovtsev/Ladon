# These run as-is on FreeBSD/OPNsense — keep LF on every checkout so a Windows
# working copy never injects CRLF (which breaks sh/php on the target).
packaging/opnsense/plugin/** text eol=lf
packaging/*.sh text eol=lf

# Same reason, one level down: the container and desktop scripts run on Linux,
# and a CRLF on the shebang line is read as part of the interpreter's name.
packaging/**/*.sh text eol=lf
packaging/**/*.py text eol=lf
